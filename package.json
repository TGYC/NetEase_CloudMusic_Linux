{
  "name": "cloudmusic-desktop",
  "productName": "CloudMusic",
  "desktopName": "cloudmusic-desktop",
  "version": "1.0.0",
  "description": "一个使用 Electron 封装的网易云音乐（NetEase Cloud Music）桌面客户端",
  "author": "CloudMusic Contributors",
  "license": "MIT",
  "main": "src/main.js",
  "homepage": "https://music.163.com",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "python3 scripts/gen-icons.py",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cloudmusic.desktop",
    "productName": "CloudMusic",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "AudioVideo;Audio",
      "icon": "build/icon.png",
      "maintainer": "CloudMusic Contributors",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {},
  "optionalDependencies": {
    "mpris-service": "^2.1.2"
  }
}
